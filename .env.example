# Cases are saved in this browser; no Firebase or server-side case database.
# Keep real keys in .env.local or server-side AI Studio Secrets, never in Git.
# Never prefix the Gemini key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BHUVERIFY_AI_ENABLED=true

# Required in production: this NEW app's exact public HTTPS origin, no path.
# Leave blank for local development, which validates the local request origin.
APP_ORIGIN=

# Development only: this NEW app's exact preview hostname, not a URL or wildcard.
# Do not reuse the old app's hostname. AI Studio: npm run dev:studio
BHUVERIFY_PREVIEW_HOST=

# Optional lower limits; these are per-process limits, NOT a spending cap.
# BHUVERIFY_AI_LIMIT_CONCURRENT=2
# BHUVERIFY_AI_LIMIT_MINUTE=12
# BHUVERIFY_AI_LIMIT_HOUR=120
# BHUVERIFY_AI_LIMIT_DAY=300
